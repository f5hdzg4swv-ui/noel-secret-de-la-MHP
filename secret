<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secret Santa de Noël 🎄🎁</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Mountains+of+Christmas:wght@700&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        christmasRed: '#C41E3A',
                        darkRed: '#7A0010',
                        christmasGreen: '#165B33',
                        darkGreen: '#0B3B24',
                        gold: '#F8B229',
                        cream: '#FBF5E8',
                    },
                    fontFamily: {
                        festive: ['"Mountains of Christmas"', 'cursive'],
                        sans: ['Poppins', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Animation de fond flocons */
        .snowflake {
            color: #fff;
            font-size: 1em;
            font-family: Arial, sans-serif;
            text-shadow: 0 0 5px #000;
            position: fixed;
            top: -10%;
            z-index: 0;
            user-select: none;
            cursor: default;
            animation-name: snowflakes-fall, snowflakes-shake;
            animation-duration: 10s, 3s;
            animation-timing-function: linear, ease-in-out;
            animation-iteration-count: infinite, infinite;
            animation-play-state: running, running;
        }

        @keyframes snowflakes-fall {
            0% { top: -10%; }
            100% { top: 100%; }
        }

        @keyframes snowflakes-shake {
            0%, 100% { transform: translateX(0); }
            50% { transform: translateX(80px); }
        }

        .snowflake:nth-of-type(0) { left: 1%; animation-delay: 0s, 0s; }
        .snowflake:nth-of-type(1) { left: 10%; animation-delay: 1s, 1s; }
        .snowflake:nth-of-type(2) { left: 20%; animation-delay: 6s, 0.5s; }
        .snowflake:nth-of-type(3) { left: 25%; animation-delay: 4s, 2s; }
        .snowflake:nth-of-type(4) { left: 40%; animation-delay: 2s, 2s; }
        .snowflake:nth-of-type(5) { left: 50%; animation-delay: 8s, 3s; }
        .snowflake:nth-of-type(6) { left: 60%; animation-delay: 6s, 2s; }
        .snowflake:nth-of-type(7) { left: 70%; animation-delay: 2.5s, 1s; }
        .snowflake:nth-of-type(8) { left: 80%; animation-delay: 1s, 0s; }
        .snowflake:nth-of-type(9) { left: 90%; animation-delay: 3s, 1.5s; }

        /* Animation cadeau qui bouge */
        @keyframes shake {
            0% { transform: rotate(0deg); }
            25% { transform: rotate(-8deg); }
            50% { transform: rotate(8deg); }
            75% { transform: rotate(-4deg); }
            100% { transform: rotate(0deg); }
        }
        .shake-box:hover {
            animation: shake 0.5s ease-in-out infinite;
        }

        /* Halo lumineux doré */
        .gold-glow {
            box-shadow: 0 0 25px rgba(248, 178, 41, 0.6);
        }
    </style>
</head>
<body class="bg-gradient-to-b from-darkGreen via-christmasGreen to-darkRed min-h-screen font-sans text-cream flex flex-col justify-between relative overflow-x-hidden">

    <!-- Flocons de neige en arrière-plan -->
    <div class="snowflakes" aria-hidden="true">
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
    </div>

    <!-- En-tête principal -->
    <header class="relative z-10 text-center pt-8 pb-4 px-4">
        <h1 class="font-festive text-5xl md:text-7xl text-gold drop-shadow-md mb-2">
            🎄 Secret Santa 🎁
        </h1>
        <p class="text-lg md:text-xl font-medium max-w-xl mx-auto text-cream opacity-90">
            Découvrez en toute discrétion la personne à qui vous allez faire un cadeau d'exception cette année !
        </p>
    </header>

    <!-- Content principal -->
    <main class="relative z-10 flex-grow container mx-auto px-4 py-6 max-w-lg">
        
        <!-- Carte de sélection du prénom -->
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 md:p-8 border border-white/20 shadow-2xl text-center">
            
            <div class="mb-6">
                <i class="fa-solid font-festive text-gold text-4xl mb-3 block">🎅 Qui êtes-vous ? 🎅</i>
                <label for="nameSelect" class="block text-sm font-semibold mb-2 text-cream/90">
                    Sélectionnez votre prénom dans la liste :
                </label>
                <select id="nameSelect" class="w-full bg-cream text-darkGreen font-bold py-3 px-4 rounded-xl shadow border-2 border-gold focus:outline-none focus:ring-4 focus:ring-gold/50 text-lg">
                    <option value="" disabled selected>-- Choisissez votre prénom --</option>
                </select>
            </div>

            <button id="drawBtn" onclick="revealTarget()" class="shake-box w-full bg-gradient-to-r from-christmasRed to-darkRed hover:from-red-600 hover:to-christmasRed text-white font-bold py-4 px-6 rounded-xl shadow-lg border-2 border-gold text-xl transition-all duration-300 flex items-center justify-center gap-3 cursor-pointer">
                <i class="fa-solid fa-gift text-gold text-2xl"></i>
                <span>Découvrir mon tirage</span>
            </button>

            <!-- Avertissement secret -->
            <p class="text-xs text-cream/70 mt-4 italic">
                <i class="fa-solid fa-user-secret mr-1"></i> Conseil : Effectuez le tirage à l'abri des regards indiscrets !
            </p>
        </div>

        <!-- Bouton Partage WhatsApp -->
        <div class="mt-8 text-center">
            <button onclick="shareWhatsApp()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-6 rounded-xl shadow-md transition duration-200 flex items-center justify-center gap-3">
                <i class="fa-brands fa-whatsapp text-2xl"></i>
                <span>Envoyer l'application sur le groupe WhatsApp</span>
            </button>
        </div>

    </main>

    <!-- Modal d'affichage du tirage (Cadeau / Secret) -->
    <div id="resultModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden transition-opacity duration-300">
        <div class="bg-gradient-to-b from-darkGreen to-christmasGreen border-4 border-gold rounded-3xl p-6 md:p-8 max-w-sm w-full text-center relative shadow-2xl gold-glow transform scale-95 transition-transform duration-300" id="modalContent">
            
            <div id="giftCardState">
                <div class="text-6xl mb-4 animate-bounce">🎁</div>
                <h3 class="font-festive text-3xl text-gold mb-2" id="greetingName">Bonjour !</h3>
                <p class="text-cream text-sm mb-6">Votre tirage au sort personnalisé est prêt.</p>

                <button onclick="openGift()" class="bg-gold hover:bg-yellow-400 text-darkGreen font-extrabold py-3 px-6 rounded-full shadow-lg border-2 border-white transition transform hover:scale-105 text-lg flex items-center justify-center gap-2 mx-auto">
                    <span>Ouvrir mon paquet</span>
                    <i class="fa-solid fa-ribbon"></i>
                </button>
            </div>

            <div id="revealedState" class="hidden">
                <p class="text-sm uppercase tracking-wider text-gold font-bold mb-1">Vous devez offrir un cadeau à :</p>
                
                <div class="bg-white/10 border-2 border-gold/50 rounded-2xl p-4 my-4 shadow-inner">
                    <h2 id="targetName" class="font-festive text-4xl text-white font-extrabold tracking-wide drop-shadow">
                        ---
                    </h2>
                </div>

                <div class="bg-christmasRed/30 border border-christmasRed rounded-xl p-3 mb-6">
                    <p class="text-xs text-cream font-medium leading-relaxed">
                        🤫 <strong>Chuuut ! Gardez le secret !</strong><br>Ne le répétez à personne pour préserver la magie de Noël.
                    </p>
                </div>

                <button onclick="closeModal()" class="w-full bg-cream text-darkGreen hover:bg-white font-bold py-3 px-6 rounded-xl shadow transition duration-200">
                    Cacher & Fermer 🔒
                </button>
            </div>
        </div>
    </div>

    <!-- Pied de page avec réinitialisation discrète -->
    <footer class="relative z-10 text-center py-4 px-4 text-xs text-cream/60">
        <p class="mb-1">Joyeux Noël & Bonnes Fêtes à tous ! ✨</p>
        <button onclick="resetGlobalDraw()" class="underline opacity-50 hover:opacity-100 transition">
            (Admin : Réinitialiser le tirage global)
        </button>
    </footer>

    <!-- Logique applicative JavaScript -->
    <script>
        // Liste fixe des participants préréglés
        const participants = [
            "Aurélien", 
            "Philippe", 
            "Maxime", 
            "Mickael", 
            "Yveline", 
            "Céline", 
            "Akim", 
            "Hadrien"
        ];

        const STORAGE_KEY = 'secret_santa_draw_2026';
        let currentDraw = {};

        // Initialisation de la page
        window.onload = function() {
            populateNameSelect();
            initDraw();
        };

        // Remplir le menu déroulant
        function populateNameSelect() {
            const select = document.getElementById('nameSelect');
            // Trier alphabétiquement pour faciliter le repérage
            const sortedNames = [...participants].sort((a, b) => a.localeCompare(b, 'fr'));
            
            sortedNames.forEach(name => {
                const opt = document.createElement('option');
                opt.value = name;
                opt.textContent = name;
                select.appendChild(opt);
            });
        }

        /**
         * Génère un tirage au sort garanti sans auto-tirage (Permutation / Derangement circulaire)
         */
        function generateDerangement(list) {
            let shuffled = [...list];
            let isValid = false;

            // Mélanger jusqu'à ce que personne ne soit tiré soi-même
            while (!isValid) {
                // Algorithme de Fisher-Yates
                for (let i = shuffled.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
                }

                // Vérification strict qu'aucun élément n'est à sa propre position
                isValid = true;
                for (let i = 0; i < list.length; i++) {
                    if (list[i] === shuffled[i]) {
                        isValid = false;
                        break;
                    }
                }
            }

            // Construit la carte des associations : { "Aurélien": "Céline", ... }
            const result = {};
            for (let i = 0; i < list.length; i++) {
                result[list[i]] = shuffled[i];
            }
            return result;
        }

        // Charger ou initialiser le tirage dans le localStorage
        function initDraw() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    currentDraw = JSON.parse(saved);
                } catch(e) {
                    currentDraw = generateAndSaveDraw();
                }
            } else {
                currentDraw = generateAndSaveDraw();
            }
        }

        function generateAndSaveDraw() {
            const newDraw = generateDerangement(participants);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(newDraw));
            return newDraw;
        }

        // Révéler le modal du participant choisi
        function revealTarget() {
            const select = document.getElementById('nameSelect');
            const selectedName = select.value;

            if (!selectedName) {
                alert("Veuillez sélectionner votre prénom dans la liste avant de continuer ! 🎅");
                return;
            }

            // S'assurer que le tirage existe
            if (!currentDraw || Object.keys(currentDraw).length === 0) {
                initDraw();
            }

            const target = currentDraw[selectedName];
            
            // Mise à jour du contenu modal
            document.getElementById('greetingName').textContent = `Bonjour ${selectedName} ! 🎄`;
            document.getElementById('targetName').textContent = target;

            // Réinitialiser les états du modal (fermé / non déballé)
            document.getElementById('giftCardState').classList.remove('hidden');
            document.getElementById('revealedState').classList.add('hidden');

            // Afficher le modal avec animation
            const modal = document.getElementById('resultModal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('modalContent').classList.remove('scale-95');
                document.getElementById('modalContent').classList.add('scale-100');
            }, 10);
        }

        // Déballer le cadeau (Action sur le modal)
        function openGift() {
            document.getElementById('giftCardState').classList.add('hidden');
            document.getElementById('revealedState').classList.remove('hidden');

            // Animation Confettis
            confetti({
                particleCount: 80,
                spread: 70,
                origin: { y: 0.6 },
                colors: ['#C41E3A', '#165B33', '#F8B229', '#ffffff']
            });
        }

        // Fermer le modal
        function closeModal() {
            const modal = document.getElementById('resultModal');
            document.getElementById('modalContent').classList.remove('scale-100');
            document.getElementById('modalContent').classList.add('scale-95');
            
            setTimeout(() => {
                modal.classList.add('hidden');
                document.getElementById('nameSelect').value = ""; // Réinitialise la sélection
            }, 200);
        }

        // Partage sur WhatsApp
        function shareWhatsApp() {
            const pageUrl = window.location.href;
            const message = `🎄 *Secret Santa 🎁*\n\nVoici le lien pour effectuer votre tirage au sort de Noël !\nCliquez sur le lien, choisissez votre prénom et découvrez en secret à qui vous faites un cadeau :\n\n${pageUrl}`;
            
            const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(message)}`;
            window.open(whatsappUrl, '_blank');
        }

        // Réinitialisation globale pour l'organisateur
        function resetGlobalDraw() {
            if (confirm("⚠️ Êtes-vous sûr de vouloir régénérer un NOUVEAU tirage au sort complet pour tout le monde ?\n(Cela effacera le tirage actuel)")) {
                currentDraw = generateAndSaveDraw();
                alert("✨ Un nouveau tirage au sort a été généré avec succès !");
                document.getElementById('nameSelect').value = "";
            }
        }
    </script>
</body>
</html>